<Window x:Class="Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        Title="安装程序" Height="560" Width="780"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#1A1C20" ResizeMode="CanResize"
        Icon="installer.ico">

    <Window.Resources>
        <!-- Windows 11 深色圆角复选框样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>

        <!-- 扁平操作按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D3139" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0,12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383D47" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#23262C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题高亮主按钮样式 (蓝色) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,0,16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1084D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#006CBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#25282F" />
                                <Setter Property="TextElement.Foreground" Value="#5C6370" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 窗口主内容区 (原生系统承载标题栏与阴影) -->
    <Grid Background="#1A1C20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- 1. 中间页面展示区 -->
        <Grid Grid.Row="0" Margin="36,16,36,12">
                <!-- 第一页：软件介绍 (Markdown 渲染 + 协议信息) -->
                <Grid x:Name="PageStepIntro" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="TxtIntroAppName" Text="FontAutoLoader" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtIntroVersion" Text="版本 1.2.0" FontSize="12" Foreground="#8A8F99" Margin="0,0,12,0" />
                                <!-- 动态开源协议徽章 -->
                                <Border x:Name="BadgeLicenseBorder" CornerRadius="3" Padding="6,1,6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLicenseName" FontSize="11" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <!-- 动态项目主页超链接入口 -->
                        <Button x:Name="BtnRepo" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                                Height="30" Padding="12,0,12,0" Click="BtnRepo_Click" />
                    </Grid>

                    <!-- Markdown 文档滚动查看区域 -->
                    <Border Grid.Row="1" Background="#24272D" CornerRadius="6" BorderBrush="#353A43" BorderThickness="1" Padding="14,10,14,10">
                        <FlowDocumentScrollViewer x:Name="DocViewer" Background="Transparent" BorderThickness="0"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <FlowDocumentScrollViewer.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6E6E6" />
                                <Style TargetType="FlowDocument">
                                    <Setter Property="Foreground" Value="#E6E6E6" />
                                    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Foreground" Value="#E6E6E6" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="LineHeight" Value="20" />
                                </Style>
                                
                                <!-- 彻底解决行内代码白底白字：强制定义深石墨底色与亮白文字 -->
                                <Style x:Key="{x:Static md:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                                    <Setter Property="Background" Value="#32363F" />
                                    <Setter Property="Foreground" Value="#F0F4F8" />
                                    <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>

                                <!-- 独立代码块深色样式 -->
                                <Style x:Key="{x:Static md:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
                                    <Setter Property="Background" Value="#1C1E23" />
                                    <Setter Property="Foreground" Value="#F0F4F8" />
                                    <Setter Property="Padding" Value="10" />
                                    <Setter Property="Margin" Value="0,6,0,10" />
                                    <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New" />
                                </Style>

                                <!-- 各级标题高亮纯白 -->
                                <Style x:Key="{x:Static md:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontSize" Value="22" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Margin" Value="0,8,0,10" />
                                </Style>
                                <Style x:Key="{x:Static md:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontSize" Value="17" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Margin" Value="0,8,0,6" />
                                </Style>

                                <!-- 补齐三级标题（### 标题）：高亮纯白 -->
                                <Style x:Key="{x:Static md:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,8,0,6" />
                                </Style>

                                <!-- 补齐四级、五级标题 -->
                                <Style x:Key="{x:Static md:Styles.Heading4StyleKey}" TargetType="{x:Type Paragraph}">
                                    <Setter Property="Foreground" Value="#F0F4F8" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,6,0,4" />
                                </Style>
                                
                                <Style TargetType="List">
                                    <Setter Property="Foreground" Value="#E6E6E6" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                                <Style TargetType="ListItem">
                                    <Setter Property="Foreground" Value="#E6E6E6" />
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                </Style>
                                <Style TargetType="Hyperlink">
                                    <Setter Property="Foreground" Value="#4CC2FF" />
                                    <Setter Property="TextDecorations" Value="None" />
                                </Style>
                            </FlowDocumentScrollViewer.Resources>
                        </FlowDocumentScrollViewer>
                    </Border>
                </Grid>

                <!-- 第二页：环境检查清单 -->
                <Grid x:Name="PageStepCheck" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="环境检查" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock x:Name="TxtCheckSummary" Text="正在验证运行环境..." FontSize="13" Foreground="#8A8F99" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Background="#24272D" CornerRadius="6" BorderBrush="#353A43" BorderThickness="1" Padding="16">
                            <StackPanel x:Name="CheckListPanel">
                                <!-- 动态插入各项检查结果 -->
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 第三页：安装路径与快捷方式配置 -->
                <Grid x:Name="PageStepConfig" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="安装配置" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="请选择软件安装目录与系统快捷方式" FontSize="13" Foreground="#8A8F99" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="安装位置" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#24272D" CornerRadius="6" BorderBrush="#353A43" BorderThickness="1">
                                    <TextBox x:Name="TxtInstallPath" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                             Padding="10,8,10,8" FontSize="13" TextChanged="TxtInstallPath_TextChanged" />
                                </Border>
                                <Button Grid.Column="2" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowse_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtSpaceInfo" Text="计算中..." FontSize="12" Foreground="#8A8F99" Margin="2,6,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0">
                            <CheckBox x:Name="ChkStartMenu" Content="创建「开始」菜单快捷方式" IsChecked="True" />
                            <CheckBox x:Name="ChkDesktop" Content="创建桌面快捷方式" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 第四页：安装进度展示 -->
                <Grid x:Name="PageStepProgress" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtInstallStatus" Text="正在释放程序组件..." FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16" />
                        <ProgressBar x:Name="InstallProgressBar" Height="6" Background="#2D3139" Foreground="#0078D4" BorderThickness="0" IsIndeterminate="True" Margin="0,0,0,12" />
                        <TextBlock x:Name="TxtCurrentAction" Text="正在准备环境..." FontSize="12" Foreground="#8A8F99" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 2. 底部操作按钮栏 -->
            <Border Grid.Row="1" Background="#16181C" Padding="24,0,24,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 第一步显示：取消安装 -->
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Click="BtnCancel_Click" />
                    <!-- 第二步显示：返回上一步 -->
                    <Button x:Name="BtnBack" Content="上一步" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Click="BtnBack_Click" />
                    <!-- 第二步显示：重新检查 -->
                    <Button x:Name="BtnRecheck" Content="重新检查" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Click="BtnRecheck_Click" />
                    <!-- 核心推进按钮：下一步 / 开始安装 / 启动并完成 -->
                    <Button x:Name="BtnNext" Content="下一步" Style="{StaticResource AccentButtonStyle}" Click="BtnNext_Click" />
                </StackPanel>
            </Border>
        </Grid>
</Window>